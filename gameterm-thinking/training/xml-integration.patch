@@ -0,0 +1,42 @@
+"""Losslessly convert a recorded native LoRA checkpoint into a NEW XML run directory."""
+import argparse
+import json
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from daycare.artifact.native_lora import checkpoint_path, digest, read_checkpoint, write_checkpoint
+
+
+def convert(source, output):
+    source, output = Path(source).resolve(), Path(output).resolve()
+    record_path = source / 'run.json'
+    if not record_path.exists():
+        record_path = source / 'training-progress.json'
+    record = json.loads(record_path.read_text())
+    if not record.get('complete'):
+        raise ValueError('source training did not complete')
+    adapter = checkpoint_path(source, record)
+    _, tensors = read_checkpoint(adapter, record)
+    output.mkdir(parents=True, exist_ok=False)
+    converted = dict(record, adapter_file='adapter.xml', adapter_format='daycare-xml-lossless',
+                     conversion={'source_adapter': str(adapter), 'source_adapter_sha256': digest(adapter),
+                                 'source_record': str(record_path), 'source_record_sha256': digest(record_path),
+                                 'note': 'Post-training format conversion; no optimization or evaluation performed.'})
+    destination = output / 'adapter.xml'
+    write_checkpoint(destination, tensors, converted)
+    converted['adapter_sha256'] = digest(destination)
+    (output / 'run.json').write_text(json.dumps(converted, indent=2) + '\n')
+    proof = dict(tensors=len(tensors), tensor_bytes_equal=True, source_dtypes=sorted({str(v.dtype) for v in tensors.values()}),
+                 source_adapter_sha256=digest(adapter), xml_adapter_sha256=digest(destination),
+                 source_record_sha256=digest(record_path), retrained=False)
+    (output / 'conversion-proof.json').write_text(json.dumps(proof, indent=2) + '\n')
+    return proof
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--run', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    print(json.dumps(convert(args.run, args.output), indent=2))
